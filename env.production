# Production Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration (Digital Ocean Managed Database)
DATABASE_URL=postgresql://username:password@your-db-host:25060/finance_flow?sslmode=require

# JWT Configuration (Generate a strong secret)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Email Configuration (for contact form)
CONTACT_EMAIL_USER=your_email@gmail.com
CONTACT_EMAIL_PASS=your_app_password

# Frontend Configuration (Digital Ocean App URL)
VITE_API_URL=https://your-backend-app.ondigitalocean.app

# Node Environment
NODE_ENV=production
