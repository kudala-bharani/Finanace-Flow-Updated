// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  accounts Account[]
  incomes  Income[]
  expenses Expense[]
  friendTransactions FriendTransaction[]
  budgetGoals BudgetGoal[]
  savingsGoals SavingsGoal[]
}

model Account {
  id      Int    @id @default(autoincrement())
  name    String
  type    String
  balance Float
  userId  Int
  user    User   @relation(fields: [userId], references: [id])
}

model Income {
  id        Int    @id @default(autoincrement())
  amount    Float
  source    String
  category  String
  date      DateTime
  description String?
  userId    Int
  user      User   @relation(fields: [userId], references: [id])
}

model Expense {
  id          Int    @id @default(autoincrement())
  amount      Float
  description String
  category    String
  date        DateTime
  userId      Int
  user        User   @relation(fields: [userId], references: [id])
}

model FriendTransaction {
  id          Int    @id @default(autoincrement())
  name        String
  amount      Float
  description String
  date        DateTime
  type        String // 'receive' or 'give'
  completed   Boolean
  userId      Int
  user        User   @relation(fields: [userId], references: [id])
}

model BudgetGoal {
  id       Int    @id @default(autoincrement())
  category String
  amount   Float
  spent    Float
  month    Int    @default(7) // Current month (July = 7)
  year     Int    @default(2025) // Current year
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
}

model SavingsGoal {
  id            Int    @id @default(autoincrement())
  name          String
  targetAmount  Float
  currentAmount Float
  targetDate    DateTime
  description   String?
  userId        Int
  user          User   @relation(fields: [userId], references: [id])
}
